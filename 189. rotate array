void rotate(int* nums, int numsSize, int k) 
{
   k=k%numsSize;

   int* result=(int*)malloc(numsSize* sizeof(int));
   int index=0;
   for(int i=numsSize-k;i<numsSize;i++)
   {
    result[index++]=nums[i];
   }
   for(int i=0;i<numsSize-k;i++)
   {
    result[index++]=nums[i];
   }

   for(int i=0;i<numsSize;i++)
   {
    nums[i]=result[i];
   }

   free(result);
}










