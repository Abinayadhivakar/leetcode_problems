void merge(int* nums1, int nums1Size, int m, int* nums2, int nums2Size, int n) {
   int i,j,k=0;
   int c[m+n] ;
   for(i=0;i<m;i++) 
   {
    c[k]=nums1[i];
    k++;
   }
    for(j=0;j<n;j++) 
   {
    c[k]=nums2[j];
    k++;
   }
   for(i=0;i<m+n-1;i++)
   {
    for(j=0;j<m+n-1-i;j++)
    {
        if(c[j]>c[j+1])
        {
        int temp=c[j];
        c[j]=c[j+1];
        c[j+1]=temp;
        }
    }
   }
   for(i=0;i<m+n;i++)
   {
    nums1[i]=c[i];
   }
}
